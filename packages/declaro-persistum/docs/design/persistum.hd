
module declaro-persistum

  layer data

  env DECLARO_CREW_SIZE : int | Absent

  env DECLARO_CONNECTIONS : int | Absent

  inputs = { "caller" : "a library call from the host program", "models" : "the Pydantic models the host declares", "database" : "what a database says it holds", "primary" : "the channel from the primary, inbound", "clock" : "the wall clock", "signal" : "the platform's shutdown", "crew" : "a drainer waking, and the writes that have arrived; on both lists because releasing a ticket reads it and writes it", "shutdown list" : "the databases that asked to replicate at exit", "random" : "where a ticket comes from; two writes in one process must never share one", "disk" : "whether a copy of a database is already on this machine" }
  outputs = { "database" : "statements, and the connection they run on", "primary" : "the channel to the primary, outbound", "signal" : "the process's one handler", "crew" : "the drainers, and the writes deposited and outcomes posted to them", "shutdown list" : "the databases shutdown works through", "log" : "what an operator reads afterwards", "disk" : "the folder a copy needs before the driver will put one in it" }

  type Fault = { kind: FaultKind
                 what_went_wrong: str
                 what_to_do_instead: str } note "a failure on its way back to a caller; it says what to do, not only what broke"

  set fault_kinds = { "conflict" : "two writers wrote one row; try again", "refused" : "the request itself is wrong; change it", "budget_spent" : "retried as many times as allowed", "cut_short" : "the process was killed before the work finished" } note "the kinds of failure, because the kind decides whether to try again"
  vocabulary FaultKind = { fault_kinds } note "which kind of failure this is"

  type Value = str | int | float | bool | NOTHING note "a value a caller passed, bound by the driver and never pasted into text"
  type Row = dict<str, Value> note "one row, as column names to values"
  type Rows = list<Row> note "the rows a driver handed back"

  type Connection = handle note "what statements run on: reads and writes to the local file, held and never read"

  type Channel = handle note "the one line to the primary, pushed and pulled along, held and never read"

  type Waiter = handle note "where one caller's outcome is put; awaited once, never read"
  type Doorbell = handle note "how a sleeping drainer is told there is work, or told to stop"
  type Drainer = handle note "one running worker, held so a crew can be stopped"
  type Turn = handle note "one pass of a drainer's loop, handed to the crew because a boundary starts what it is given and never decides what that is"
  type Narrowing = dict<str, AskedValue> note "a caller's narrowing as they wrote it: a bare value, a named operator, or `or` and `not` holding more of the same"
  type AskedValue = Value | Row | Rows | Condition | Narrowing | list<Narrowing> | list<str> | list<Value> | dict<str, Direction> note "what may stand beside a key once a reader has lifted it out of the writing"

  type MethodNames = dict<str, str> note "one way of writing's method name for each field, over a real parse; `filter` is Django's word for the narrowing and `filter_by` is SQLAlchemy's"

  type Asked = dict<str, AskedValue> note "the parts one reader lifted out of one way of writing, in the library's own words; four readers make this and one builder turns it into a declaration"
  type Written = str note "the question as the caller typed it, in one of the four spellings; punctuation and shape differ, so the text itself says which"

  type Database = { target: str
                    engine: Engine
                    connections: list<Connection>
                    writers: list<Connection>
                    channel: Channel | NOTHING
                    crew: Crew
                    shutdown: Shutdown } note "what opening gives you, and what every later call reads"

  type Declared = { models: list<Model>
                    views: list<View>
                    dropping_tables: list<str>
                    dropping_views: list<str> } note "the models and views the code declares"

  type Model = { name: str
                 table: str
                 columns: list<Column>
                 dropping: list<str>
                 indexes: list<Index>
                 constraints: list<Constraint> } note "your description of one table, which is the only description there is"

  # --- the schema, which is the models and nothing else --------------------

  set deletion_rules = { "refuse", "cascade", "set_null" } note "what happens to a child row when its parent is deleted"
  vocabulary OnDelete = { deletion_rules } note "refuse the delete, delete the child too, or empty the column"

  type Reference = { table: str
                     column: str
                     on_delete: OnDelete } note "where a foreign key points and what a delete does to the child"

  set declared_types = { "text", "integer", "float", "decimal", "boolean", "bytes", "date", "time", "datetime", "uuid", "json" } note "what a column may hold, in words no engine uses"
  vocabulary DeclaredType = { declared_types } note "what one column holds"

  type Column = { name: str
                  declared_type: DeclaredType
                  renamed_from: str | NOTHING
                  references: Reference | NOTHING } note "one column: what it is called, what it holds, what it was called before, and where it points"

  type Index = { name: str
                 columns: list<str>
                 unique: bool } note "a declared promise about speed"

  set constraint_kinds = { "check" : "a rule the value must satisfy", "primary_key" : "the column that names the row", "unique" : "no two rows share it", "length" : "how long the value may be", "not_null" : "the column must hold something", "default" : "what goes in when a write names no value" } note "every rule you can declare about a column or a table; a new one is one more line here"
  vocabulary ConstraintKind = { constraint_kinds } note "which kind of rule this is"

  type Constraint = { name: str
                      kind: ConstraintKind
                      columns: list<str>
                      rule: Condition
                      value: Value } note "one declared rule, over a column or a whole table, as data rather than a string; `rule` is what a check reads and `value` is the number a length allows or the value a default writes"

  type Table = { name: str
                 columns: list<Column>
                 indexes: list<Index>
                 constraints: list<Constraint> } note "one table's columns, indexes and rules"

  type View = { name: str
                declaration: Declaration
                freshness: Freshness | NOTHING } note "a declared query with a name; it holds a declaration, never a SELECT"

  set freshnesses = { "always current", "current when read", "refreshed when asked" } note "how fresh a materialized view must be, in requirements rather than mechanisms"
  vocabulary Freshness = { freshnesses } note "how stale a materialized view may be"

  type Schema = { tables: list<Table>
                  views: list<View> } note "every table and view, live or declared"

  type Inspecting = { tables: Statement
                      columns: Statement
                      indexes: Statement
                      constraints: Statement
                      views: Statement
                      types: dict<str, DeclaredType> } note "the five questions one engine answers about itself and its own word for each thing a column can hold, so reading a schema back names no engine"

  # WHAT THE DIFFER EMITS. Each operation says whether carrying it out destroys
  # something, so the library says which of them do, derived from the models
  # rather than asked for.
  set operation_kinds = { "create_table", "drop_table", "add_column", "drop_column", "alter_column", "rename_column", "rename_table", "create_index", "drop_index", "create_view", "drop_view", "insert_enum_values", "remove_enum_values" } note "every schema change the differ can emit"
  vocabulary OperationKind = { operation_kinds } note "which schema change this is"

  type Carrying = { columns: bool
                    indexes: bool
                    constraints: bool
                    copying: bool
                    values: bool
                    renamed_to: bool
                    view: bool } note "which fields one kind of change fills; adding a kind of change is one more line in this table"

  type Operation = { kind: OperationKind
                     table: str
                     column: str | NOTHING
                     columns: list<Column>
                     indexes: list<Index>
                     constraints: list<Constraint>
                     copying: list<str>
                     values: list<Value>
                     renamed_to: str | NOTHING
                     view: View | NOTHING
                     destroys: bool } note "one schema change, every field it may fill named, and whether it destroys anything"

  type Plan = { operations: list<Operation>
                destroys: list<str> } note "the operations a migration would run, in order"

  set migration_modes = { "all_or_nothing" : "every operation lands or none does", "per_operation" : "each one lands on its own" } note "how far back a failed migration rolls on this engine"
  vocabulary MigrationMode = { migration_modes } note "how far back a failed migration rolls"

  type Report = { plan: Plan
                  applied: int } note "what a migration actually did"

  type Spelling = { statements: list<str>
                    rebuilds: bool } note "how one engine writes one schema change: the statements it takes, and whether it gets there by rebuilding the table"

  set features = { "materialized_view", "check_constraint", "partial_index", "enum", "range_type" } note "the things the three engines disagree about"
  vocabulary Feature = { features } note "which engine capability is in question"

  type Capability = { native: bool
                      built_from: str } note "what an engine offers natively, and what builds it where it does not"

  set engines = { "sqlite" : "a bare path, or a sqlite scheme", "postgresql" : "a postgresql or postgres scheme", "turso" : "a libsql scheme, or a path with a primary" } note "the three engines, and what in a target names each"
  vocabulary Engine = { engines } note "which engine a database is on, decided once at open"

  set shutdowns = { "exit_immediately" : "stop, and anything only local is gone", "replicate_then_exit" : "push until the cloud has it, then stop" } note "what happens to your data at exit; no default, because none is safe"
  vocabulary Shutdown = { shutdowns } note "which shutdown policy a caller chose"

  type Declaration = { model: str
                       wanted: Wanted
                       columns: list<str>
                       condition: Condition
                       order: dict<str, Direction>
                       grouping: list<str>
                       having: Condition
                       paging: dict<str, int> | NOTHING
                       rows: Rows | NOTHING
                       shaping: Shaping
                       across: list<Join> | NOTHING } note "one question or write, engine-free; what four grammars produce"

  type Join = { model: str
                by_column: str
                to_column: str
                condition: Condition } note "a path to another model, worked out from its foreign key"

  set readings = { "all", "one", "first", "page", "distinct", "exists", "count", "sum", "average", "smallest", "largest", "count_distinct" } note "the twelve askings that run now and answer now; this is the read half of the fork"
  set writings = { "add", "change", "change_all", "remove", "remove_all", "replace" } note "the six askings that are deposited and drained later; the write half of the fork"
  vocabulary Wanted = { readings, writings } note "what a question asks for, reading or writing"

  set operators = { "eq", "ne", "lt", "lte", "gt", "gte", "in", "not_in", "between", "like", "contains", "startswith", "endswith", "is_null", "is_not_null" } note "the fifteen ways to narrow, named as keys"
  vocabulary Operator = { operators } note "which comparison a condition makes"

  type Comparison = { operator: Operator
                      value: Value | list<Value>
                      ignore_case: bool } note "one comparison: an operator, the value or values bound to it, and whether case matters"
  type Condition = { each: dict<str, Comparison>
                     any_of: list<Condition>
                     none_of: list<Condition> } note "how a question narrows, as data in every grammar"

  set value_shapes = { "one" : "one value beside the symbol", "list" : "a list of them", "range" : "two, a floor and a ceiling", "pattern" : "one value wrapped in a pattern", "none" : "no value at all" } note "how many values a comparison puts beside its symbol"
  vocabulary ValueShape = { value_shapes } note "how many values this comparison takes"

  type Comparing = { symbol: str
                     shape: ValueShape
                     wraps: str
                     ignoring_case: str } note "how one engine writes one comparison: the symbol, how many values go beside it, the pattern a value is wrapped in, and what it says instead when case does not matter"

  set directions = { "ascending", "descending" } note "which way an order sorts"
  vocabulary Direction = { directions } note "ascending or descending"

  set grammars = { "pseudo_sql", "django", "prisma", "sqlalchemy" } note "the four ways to phrase one question"
  vocabulary Grammar = { grammars } note "which grammar spelled this question, read off the text rather than named by the caller"

  type Statement = { text: str
                     parameters: dict<str, Value> } note "a statement for one engine, and the values kept beside it"

  set parameter_styles = { "named", "positional" } note "how a driver wants the values handed to it"
  vocabulary ParameterStyle = { parameter_styles } note "named or positional"

  type Transacting = { begin: str
                   parameters: ParameterStyle
                   commits: bool } note "what one engine needs around a write: the statement that opens it, how values go in, and whether there is a commit"

  type Answer = Rows | list<Instance> | int | bool | NOTHING note "what a caller gets back: rows, your own objects, a number, true or false, or NOTHING"

  type Instance = handle note "one of your own model objects, built from a row and handed straight back; nothing in here ever reads one"

  set shapings = { "dictionaries" : "column name to value, which is what a partial row can be", "objects" : "your model, built from a whole row" } note "what shape a caller wants its rows back in"
  vocabulary Shaping = { shapings } note "which shape the caller asked its rows back in"

  type Ticket = str note "one caller's claim on one deposited write"

  type Receipt = { id: str
                   ok: bool
                   touched: int
                   attempts: int
                   failure: Fault | NOTHING } note "what a write did, and how many rows it touched"
  type Crew = { arrivals: list<Ticket>
                writes: dict<Ticket, Statement>
                waiting: dict<Ticket, Waiter>
                arrived: Doorbell
                stop: Doorbell
                drainers: list<Drainer>
                size: int } note "N drainers, each holding one connection for its life, over the writes that have arrived"

  type Draining = { db: Database
                    writer: Connection
                    stop: Doorbell
                    idle: float } note "what one drainer holds for its whole life: the database, the one connection it writes on, its stop and how long it sleeps"

  type Connecting = { target: str
                      shutdown: Shutdown
                      primary: str | NOTHING
                      token: str | NOTHING
                      connections_asked: int | NOTHING
                      crew_asked: int | NOTHING
                      engine: Engine
                      copy_was_here: bool
                      settings: dict<str, Value>
                      permitted: int
                      crew_size: int
                      writers: list<Connection>
                      connections: list<Connection>
                      channel: Channel | NOTHING
                      declared: Declared
                      live: Schema
                      wanted_schema: Schema
                      needs_migration: bool
                      migration: Report
                      database: Database } note "what session_connect carries while it opens a database, and copy_was_here is the disk's answer from before anything opened, because opening a connection makes the file: measured 2026-10-10, turso.aio.connect leaves a database at a path that held nothing a moment earlier, so the same question asked later always answers yes"

  type ShuttingDown = { databases: list<Database>
                        started_at: float
                        attempts: int } note "what shutdown carries: when it began and how many pushes it has made"

  type CatchingUp = { db: Database
                      writer: Connection
                      statement: Statement | NOTHING
                      writer_waiting: bool
                      attempts: int } note "what a free turn carries, including whether a writer was waiting"

  type Answering = { db: Database
                     model: Model
                     grammar: Grammar
                     written: Written
                     declaration: Declaration
                     statement: Statement
                     ticket: Ticket
                     receipt: Receipt
                     rows: Rows
                     answer: Answer } note "what answering a question carries, step by step in order"

  # --- column 1: input I/O, and there are five ways in --------------------

  boundary_in fn session_open : (target: str, shutdown: Shutdown, primary: str | NOTHING, token: str | NOTHING) -> Database awaited side_effect reads "caller" side_effect reads "env:DECLARO_CREW_SIZE" side_effect reads "env:DECLARO_CONNECTIONS" invokes session_connect raises could_not_open note "opens a database for a caller; the target says which engine, so nobody names one" note "the one function here that raises, and it raises so a server cannot start on a database that would not open: a caller handed a fault at boot can ignore it and serve requests against nothing, and the worst of those is a change that would destroy data nobody declared, which has to stop the deploy rather than be reported to it"

  boundary_in fn query_ask : (db: Database, model: Model, written: Written) -> Answer | Fault awaited side_effect reads "caller" invokes query_answer note "takes a question or a declared write, as the caller wrote it" note "it arrives as text, in whichever of the four spellings the caller finds familiar, and the library reads which one it is: a word from the caller would be the same fact kept twice, and the four look nothing alike"

  boundary_in fn lifecycle_stop : () -> NOTHING | Fault awaited side_effect reads "signal" invokes lifecycle_shut_down note "receives the platform's shutdown signal"

  reader fn lifecycle_read_registered : () -> list<Database> | Fault side_effect reads "shutdown list" note "reads the databases that asked to replicate at exit"

  reader fn clock_read : () -> float side_effect reads "clock" note "asks the clock what time it is"

  reader fn copy_on_disk : (target: str) -> bool side_effect reads "disk" note "whether a copy is already there; the calling program cannot know, so the library looks" note "it takes the target a caller wrote and reads the path out of it, which session_open_connection and session_open_channel also do inside themselves: an output boundary is a terminus and cannot invoke a card, so that reading is written in each place that needs it and a card for it would be a fourth copy rather than one" note "session_connect asks before it opens anything, because opening makes the file"

  boundary_in fn lifecycle_turn : (draining: Draining) -> NOTHING | Fault awaited side_effect reads "crew" invokes lifecycle_catch_up note "one drainer's turn, which arrives because that drainer woke"

  # --- column 2: one orchestrator per door --------------------------------

  orchestrator fn session_connect : (connecting: Connecting) -> Connecting | Fault awaited invokes engine_of, copy_on_disk, refuse_unusable_settings, permitted_connections, session_open_connection, crew_size, session_open_writer, session_open_channel, crew_make, crew_start, replicates, lifecycle_install_handler, lifecycle_register, channel_push, channel_pull, schema_read_declared, refuse_owned_names, schema_from_declared, schema_inspect, migration_needed, difference, name_what_is_ambiguous, order_operations, name_what_destroys, what_an_operation_carries, refuse_undeclared_loss, how_to_migrate, how_to_inspect, capability_of, mechanism_for, spell_operation, how_to_write, query_run_statement, query_run_together, session_close_connection, log_write note "works out the engine, connects, and builds the handle everything downstream reads" note "it asks the disk whether a copy is already there, so filling one is a thing it chose rather than a thing it assumed; a warm copy pulled again costs a round trip to the primary for nothing" note "on a replicated database it pushes before it pulls, and refuses the open if the push did not land, because the live schema it reads afterwards is the local copy and a pull replays unpushed local changes on top of it: a schema change that never reached the primary then reads as already applied and nothing ever sends it again" note "that push is the first call on the channel, so it is also what proves the channel reaches a primary at all, and on a copy with nothing on it yet it is what fills the copy"

  orchestrator fn query_answer : (asking: Answering) -> Answering | Fault awaited invokes grammar_of, methods_of, asked_from_written, declaration_from_asked, refuse_undeclared_columns, refuse_some_columns_as_an_object, join_between, compile_statement, travels_together, query_run_statement, query_run_together, crew_deposit, crew_release_ticket, refusal_reaches_caller, answer_from_rows, answer_from_receipt, log_write note "turns a caller's question into rows or a number, waiting on the crew when it is a write"

  orchestrator fn lifecycle_shut_down : (shutting_down: ShuttingDown) -> ShuttingDown | Fault awaited invokes lifecycle_read_registered, crew_stop, replicates, clock_read, channel_push, next_wait, progress_line, session_close_connection, log_write note "gets every local commit to the primary before the process dies"

  orchestrator fn lifecycle_catch_up : (catching_up: CatchingUp) -> CatchingUp | Fault awaited invokes crew_wait_for_work, writer_waiting, next_in_order, how_to_write, crew_run_write, worth_retrying, budget_spent, clock_read, next_wait, receipt_for, crew_post_receipt, replicates, channel_push, channel_pull, log_write note "spends a free turn running what the crew holds, then syncing if nobody is writing"

  # --- column 3: output I/O, and there are four ways out ------------------

  boundary_out fn session_open_connection : (target: str, engine: Engine, connections: int) -> Connection | Fault awaited side_effect reads_writes "database" note "asks the driver for a connection"

  boundary_out fn query_run_statement : (connection: Connection, engine: Engine, statement: Statement) -> Rows | int | Fault awaited side_effect reads_writes "database" note "runs one statement on the connection it is handed, and on no other"

  reader fn channel_pull : (channel: Channel) -> NOTHING | Fault awaited side_effect reads "primary" note "brings down what the primary has and this copy does not"
  boundary_out fn channel_push : (channel: Channel) -> NOTHING | Fault awaited side_effect writes "primary" note "sends local commits to the primary" note "on a new channel it is the first call, so it does three things at once: it proves the driver built its sync half, it sends whatever is local, and on a copy with nothing on it yet it brings the primary's whole schema down, measured 2026-10-10 at twenty-three tables with the pull after it bringing nothing"

  boundary_out fn session_close_connection : (connection: Connection) -> NOTHING | Fault awaited side_effect writes "database" note "closes one connection" note "two callers: shutdown, once it has pushed; and session_connect, when a step refuses after connections were already opened, because a caller who never received the handle cannot have written through them, so closing loses nothing and leaving them open leaks a thread for the life of the process"

  boundary_out fn session_open_writer : (target: str, engine: Engine) -> Connection | Fault awaited side_effect reads_writes "database" note "opens one drainer's connection, held for its life"

  boundary_out fn session_open_channel : (target: str, primary: str, token: str) -> Channel | Fault awaited side_effect writes "disk" note "opens the one line to the primary, held for the life of the database" note "it makes the folder first, because the driver takes a path and will not make the directory around it, and the open makes the file as well" note "it reaches no primary and proves nothing: measured 2026-10-10, the driver builds its sync half on the first push or pull, and before that call a channel to a primary that does not exist is the same object as a live one, so there is nothing an open can look at and no round trip it could spend to find out" note "channel_push is that first call, which is why a dead primary is refused there and not here"

  boundary_out fn crew_start : (db: Database, turn: Turn) -> Crew | Fault awaited side_effect writes "crew" note "hands one drainer per writer to the runtime, each running the turn it was given, and keeps them so they can be stopped"

  boundary_out fn crew_stop : (crew: Crew) -> NOTHING | Fault awaited side_effect writes "crew" note "stops every drainer and waits for each to put its connection down"

  boundary_out fn query_run_together : (writer: Connection, engine: Engine, statements: list<Statement>, transacting: Transacting) -> int | Fault awaited side_effect writes "database" note "runs several writes as one transaction on one writer, the only rollback there is"

  boundary_out fn crew_run_write : (writer: Connection, engine: Engine, statement: Statement, transacting: Transacting) -> int | Fault awaited side_effect writes "database" note "runs one write the way the engine needs it, reading the words off the record it is handed"

  boundary_out fn crew_deposit : (crew: Crew, statement: Statement) -> Ticket | Fault side_effect writes "crew" side_effect reads "random" note "hands a write to the crew, leaves a waiter, rings the doorbell and takes a ticket"

  boundary_out fn lifecycle_install_handler : () -> NOTHING | Fault side_effect writes "signal" note "installs the signal handler, chaining to whatever was already there"

  boundary_out fn lifecycle_register : (db: Database) -> NOTHING | Fault side_effect writes "shutdown list" note "adds a replicating database to the list shutdown works through"

  boundary_out fn crew_release_ticket : (crew: Crew, ticket: Ticket) -> Receipt | Fault awaited side_effect reads_writes "crew" note "awaits this caller's own waiter and takes its ticket off the crew"

  boundary_out fn crew_post_receipt : (crew: Crew, ticket: Ticket, receipt: Receipt) -> NOTHING | Fault side_effect writes "crew" side_effect writes "log" note "hands a write's outcome to the waiter its caller is parked on"

  boundary_out fn crew_wait_for_work : (draining: Draining) -> NOTHING | Fault awaited side_effect reads_writes "crew" note "sleeps until a write arrives, the crew stops, or the idle limit runs out"

  reader fn schema_read_declared : () -> Declared | Fault side_effect reads "models" note "asks the code which models and views it declares"

  reader fn schema_inspect : (connection: Connection, engine: Engine, inspecting: Inspecting) -> Schema | Fault awaited side_effect reads "database" note "asks a database the five questions and builds what it holds out of the answers"

  boundary_out fn log_write : (event: dict<str, Value>) -> NOTHING side_effect writes "log" note "writes a line an operator reads afterwards; a failure never travels here"

  # --- the pure core, so far only what `session_connect` reaches -------------------

  fn engine_of : (target: str) -> Engine | Fault note "reads a target and names one of three engines; it opens nothing"

  fn refuse_unusable_settings : (engine: Engine, settings: dict<str, Value>) -> dict<str, Value> | Fault note "refuses a setting the detected engine cannot use, rather than ignoring it"

  fn crew_size : (asked: int | NOTHING) -> int | Fault note "settles how many drainers run, from what the deployment asked for"

  fn permitted_connections : (asked: int | NOTHING) -> int | Fault note "settles how many connections this database opens, from what the deployment asked for"

  # --- what `query_answer` reaches ----------------------------------------------

  fn compile_statement : (declaration: Declaration, engine: Engine) -> Statement | Fault invokes how_to_compare note "compiles a declaration into a statement for one engine, values kept out"

  fn refuse_undeclared_columns : (model: Model, declaration: Declaration) -> NOTHING | Fault note "refuses a column no model declares, naming the model and its columns"

  fn refuse_some_columns_as_an_object : (declaration: Declaration) -> NOTHING | Fault note "refuses a question that asks for some columns and for your own model at once, naming both words"

  fn travels_together : (declaration: Declaration) -> bool note "answers whether these writes have to land together"

  fn answer_from_receipt : (receipt: Receipt) -> Answer | Fault note "turns what the drainer did into the count a caller reads"

  fn answer_from_rows : (model: Model, rows: Rows, declaration: Declaration) -> Answer | Fault note "shapes driver rows the way the caller asked: your own objects, plain rows, a number, true or false, or NOTHING"

  fn condition_from_narrowing : (narrowing: AskedValue) -> Condition | Fault note "turns what a caller wrote into the condition this library holds: a bare value means eq, `or` and `not` become `any_of` and `none_of`"

  fn methods_of : (grammar: Grammar) -> MethodNames note "the method names one way of writing uses, one row per way; adding a fifth is one more row"

  fn asked_from_written : (written: Written, methods: MethodNames) -> Asked | Fault note "reads the writing and lifts the parts out: a model, then either a chain of calls or one call carrying named parts, with the method names telling which part is which"

  fn declaration_from_asked : (asked: Asked) -> Declaration | Fault invokes condition_from_narrowing note "turns the parts a reader lifted into the one declaration all four ways of writing build; this is the shared work, and the only place a missing part is told no"

  fn grammar_of : (written: Written) -> Grammar | Fault note "which way of writing this is, read off the punctuation and the shape; `.objects.` is Django, `.query.` is SQLAlchemy, `find_many(` is Prisma, and a bare method on the model is the library's own"


  # --- what `lifecycle_shut_down` and `lifecycle_catch_up` reach ------------------------------

  fn replicates : (db: Database) -> bool note "answers whether this database replicates, derived from whether it holds a channel"

  fn next_wait : (attempt: int, now: float, ticket: Ticket) -> float note "works out how long to wait before the next attempt"

  fn progress_line : (db: Database, elapsed: float, done: bool) -> dict<str, Value> note "builds a shutdown log line naming the database and the time elapsed"

  boundary_out fn crew_make : () -> Crew side_effect writes "crew" note "builds a crew with nobody in it yet, and the doorbell a drainer sleeps on"

  fn writer_waiting : (crew: Crew) -> bool note "answers whether a writer is waiting for the connection"

  fn next_in_order : (crew: Crew) -> Ticket | NOTHING note "answers whose write is next, in arrival order; taking it out is the boundary's work"

  fn worth_retrying : (fault: Fault) -> bool note "answers whether a failure is worth another attempt, asked of its kind"

  fn budget_spent : (attempts: int, budget: int) -> bool note "answers whether the retry budget is gone"

  fn refusal_reaches_caller : (fault: Fault) -> bool note "decides whether a fault is raised or comes back as a receipt"

  fn receipt_for : (ticket: Ticket, touched: int, failure: NOTHING | Fault, attempts: int) -> Receipt note "builds the receipt a caller reads for its write"

  # --- what the schema half reaches ---------------------------------------

  fn refuse_owned_names : (declared: Declared) -> NOTHING | Fault note "refuses a model that claims a name the library or an engine owns"

  fn schema_from_declared : (declared: Declared) -> Schema | Fault note "builds the target schema from what the code declares, and from nothing else"

  fn refuse_undeclared_loss : (plan: Plan, declared: Declared) -> Plan | Fault note "stops a migration that would destroy something no model asked to lose"

  fn migration_needed : (live: Schema, target: Schema) -> bool note "answers whether the database still has to be brought up to the models"

  fn difference : (live: Schema, target: Schema) -> list<Operation> note "works out which operations turn the live schema into the target"

  fn name_what_is_ambiguous : (operations: list<Operation>, declared: Declared) -> list<Operation> | Fault note "stops on a change that could be a rename or a drop and an add"

  fn order_operations : (operations: list<Operation>) -> list<Operation> | Fault note "puts the operations in an order their dependencies allow"

  fn name_what_destroys : (operations: list<Operation>) -> Plan note "marks which operations lose data"

  fn capability_of : (engine: Engine, feature: Feature) -> Capability note "answers whether an engine does this natively, and what builds it if not"

  fn how_to_write : (engine: Engine) -> Transacting note "reads the writers table and hands back what one engine needs around a write"

  fn how_to_migrate : (engine: Engine) -> MigrationMode note "reads the facts table and hands back how far back a failed migration rolls"

  fn how_to_inspect : (engine: Engine) -> Inspecting note "reads the inspectors table and hands back the five questions this engine answers about itself"

  fn how_to_spell : (kind: OperationKind, engine: Engine) -> Spelling | Fault note "reads the generators table and hands back how this engine writes this change"

  fn what_an_operation_carries : (kind: OperationKind) -> Carrying note "reads the operations table and hands back which fields this kind of change fills"

  fn how_to_compare : (operator: Operator, engine: Engine) -> Comparing | Fault note "reads the operators table and hands back how this engine writes this comparison"

  fn spell_operation : (operation: Operation, engine: Engine) -> list<Statement> | Fault invokes how_to_spell, spell_view note "turns one schema change into the statements that carry it out"

  # --- what a question across models reaches -------------------------------

  fn join_between : (near: Model, far: Model, condition: Condition) -> Join | Fault note "works out the join from the foreign key the model already declared"

  # --- what a declared view reaches ---------------------------------------

  fn spell_view : (view: View, engine: Engine) -> Statement | Fault invokes compile_statement note "writes the SELECT a declared view stands for"

  fn mechanism_for : (freshness: Freshness, engine: Engine, capability: Capability) -> list<Operation> | Fault note "picks the mechanism that gives a materialized view the freshness asked for"
