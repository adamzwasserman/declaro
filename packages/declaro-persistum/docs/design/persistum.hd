# declaro-persistum, declared from the specification.
#
# SOURCES, IN ORDER, AND NOTHING ELSE. `HOW-IT-SHOULD-WORK.md` says what a
# caller can ask for. `docs/architecture.md` says what shape it has to take.
# `tests/bdd/features/` says it again as scenarios, one file per function. No
# source file was opened: a declaration written from the code describes what
# exists, and then the two are one thing wearing two names and neither can check
# the other.
#
# SO PARTS OF THIS ARE NOT BUILT, and that is what a target is for.

module declaro-persistum

  layer data

  # --- the closed sets --------------------------------------------------
  #
  # Each is a vocabulary the documents name, written as one rather than as
  # `str`, because `str` admits every string and a test then has to go looking
  # for the few that mean something.

  set engines = { "postgresql", "sqlite", "turso" }
  vocabulary Engine = { engines }

  set directions = { "ascending", "descending" }
  vocabulary Direction = { directions }

  # "Fifteen operators, named as keys because a condition is data."
  set operators = {
    "eq", "ne", "lt", "lte", "gt", "gte", "in", "not_in", "between",
    "like", "contains", "startswith", "endswith", "is_null", "is_not_null"
  }
  vocabulary Operator = { operators }

  # The whole vocabulary, and every one of them means one thing.
  set words = {
    "all", "one", "first", "page", "ordered_by", "values", "distinct", "exists",
    "count", "sum", "average", "smallest", "largest", "count_distinct",
    "grouped_by", "having",
    "add", "change", "change_all", "remove", "remove_all", "replace",
    "of"
  }
  vocabulary Word = { words }

  # "You say that in plain terms", for a materialized view.
  set freshness = { "always", "hourly", "daily", "on_demand" }
  vocabulary Freshness = { freshness }

  # `a_model_declares_and_does_nothing_else.feature`: "the rules are a table, so
  # the checker knows nothing about validators". One row per habit a model must
  # not carry.
  set habits = { "validator", "method", "property", "inheritance" }
  vocabulary Habit = { habits }

  # --- what a caller declares -------------------------------------------

  type Column = {
    means: str
    optional: bool
    references: str
  }

  type Model = {
    table: str
    columns: dict<str, Column>
  }

  type Schema = dict<str, Model>

  # A condition is data and it nests: `{"or": [{...}, {...}]}` is in the
  # specification, so a flat list of triples cannot hold one. `ignore_case` is
  # the companion every text operator takes.
  type Condition = {
    column: str
    operator: Operator
    value: any
    ignore_case: bool
    any_of: list<Condition>
    none_of: list<Condition>
  }

  type Ordering = {
    column: str
    direction: Direction
  }

  type Paging = {
    size: int
    number: int
  }

  # WHAT FOUR GRAMMARS PRODUCE. "Each is a thin skin over the same declaration."
  # A view holds one of these too, which is what makes "the library writes the
  # SELECT" mean something.
  #
  # NO DATABASE FIELD. A view is declared in a schema file with no database in
  # sight, so a database cannot be part of the value.
  type Declaration = {
    word: Word
    model: Model
    columns: list<str>
    narrowing: list<Condition>
    order: list<Ordering>
    paging: Paging
    measures: dict<str, Word>
    kept: list<Condition>
    values: dict<str, any>
    related: Model
  }

  # `several_writes_travel_together.feature`: "a group is declared, and the
  # calls inside it travel together", "a group reports what it did as one
  # answer". A list handed to one `add` lands together; two separate calls do
  # not, unless they are in one of these.
  type Group = {
    declarations: list<Declaration>
  }

  type View = {
    name: str
    declares: Declaration
    materialized: bool
    fresh: Freshness
  }

  type Index = {
    name: str
    columns: list<str>
    unique: bool
  }

  # Everything one schema file declares. `View` and `Index` are here rather than
  # loose, because "a view is a query with a name, you declare it against your
  # models the way you declare a table".
  type Declared = {
    models: Schema
    views: dict<str, View>
    indexes: dict<str, Index>
  }

  # --- what comes back --------------------------------------------------

  # "A function that cannot do its job returns that fact to you. It does not
  # write it to a log nobody reads, and it does not carry on and report
  # success." `habit` is set when the failure is a model carrying behaviour.
  type Failure = {
    what: str
    because: str
    habit: Habit
  }

  # ONE SHAPE FOR EVERY WORD, and a word fills one key.
  #
  # `rows` EMPTY AND `row` ABSENT ARE DIFFERENT ANSWERS. "No rows is an empty
  # answer, not an absence", and a row that is not there is a named absence you
  # have to look at. Two keys, because they are two facts.
  #
  # `attempts` because "how many times it tried is in the answer", and a budget
  # that ran out is an answer rather than an exception.
  type Answer = {
    rows: list<any>
    row: any
    number: float
    truth: bool
    mappings: list<dict<str, any>>
    attempts: int
    failure: Failure
  }

  # What rendering produces: the statement, and the values it did NOT write into
  # it, kept apart so the driver binds them.
  type Statement = {
    sql: str
    parameters: dict<str, any>
  }

  # --- the schema half ---------------------------------------------------

  type Operation = {
    kind: str
    table: str
    detail: dict<str, any>
  }

  # "Ambiguity comes back instead of getting guessed. A column gone and another
  # one showing up is either a rename or a drop plus an add, and the difference
  # is your data."
  type Ambiguity = {
    table: str
    gone: str
    arrived: str
  }

  type Difference = {
    operations: list<Operation>
    order: list<int>
    ambiguities: list<Ambiguity>
  }

  # --- the handle ---------------------------------------------------------

  # "Data carrying its own injected callables and its engine, decided once."
  # `connections` is here because the bound on them is stated where the database
  # is opened, and `shutdown` because there is no safe default for whether your
  # data survives.
  type Database = {
    target: str
    engine: Engine
    primary: str
    connections: int
    shutdown: str
    connect: any
    close_connection: any
  }

  # --- the write queue ---------------------------------------------------

  type Room = {
    arrivals: list<Declaration>
    waiting: dict<str, any>
  }

  type Receipt = {
    ticket: str
    ok: bool
    attempts: int
    failure: Failure
  }

  # "Retries back off, with jitter", and "the budget has no default".
  type Retry = {
    attempts: int
    base_delay_s: float
    max_delay_s: float
    jitter: float
  }

  # --- column 1: input I/O -----------------------------------------------

  boundary_in fn load_models : (module_path: str) -> Declared side_effect reads "python_module"

  # One door for every engine. The target says what is behind it, so a caller
  # never names one. The bound on connections and the shutdown policy are stated
  # here because this is the only place they can be.
  boundary_in fn open_database : (target: str, shutdown: str, connections: int) -> Database side_effect reads "network" invokes engine_of

  # --- column 4: output I/O ----------------------------------------------
  #
  # EVERY DATABASE TOUCH IS ON THE RIGHT, and that is the direction of the call
  # rather than of the data. A statement goes out; rows are what the call
  # returns, and a return runs right to left by definition. Put a database read
  # on the left and every orchestrator that reads reaches backwards.

  boundary_out fn execute : (db: Database, statement: Statement) -> list<any> side_effect reads_writes "database"

  boundary_out fn introspect : (db: Database) -> Schema side_effect reads_writes "database"

  # The transaction scope, and the only thing here that gives you rollback.
  # Commits on a clean exit, rolls back on an exception, and closes the
  # connection even when the work fails.
  boundary_out fn writing : (db: Database) -> any side_effect writes "database"

  boundary_out fn replicate : (db: Database) -> bool side_effect writes "network"

  boundary_out fn close : (db: Database) -> Database side_effect writes "network"

  # --- column 3: the pure core -------------------------------------------
  #
  # "Diffing, ordering, ambiguity detection, validation, SQL rendering: all
  # functions over data, and none of them opens anything."

  # THE CHECK THAT MAKES THE SURFACE DECLARATIVE. "Ask for a column no model
  # declares, and the library stops you in your own process. It names your model
  # and lists the columns it does declare." `all`, `values`, `change`,
  # `ordered_by` and `of` each carry a scenario for this refusal.
  fn checked : (model: Model, columns: list<str>) -> list<str> | Failure

  # "A model that only declares is accepted." A validator, a method, a property
  # or inheriting from anything but BaseModel is behaviour the library cannot
  # see, and every habit found is reported rather than just the first.
  fn habits_in : (model: Model) -> list<Failure>

  # The pure decision `open_database` rests on. A string in, one of three words
  # out, and it opens nothing.
  fn engine_of : (target: str) -> Engine | Failure

  # THE FOUR GRAMMARS. Four thin skins, one value, and a fifth is a fifth card
  # here that changes nothing to its right.
  fn declared_in_pseudo_sql : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  fn declared_in_django : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  fn declared_in_prisma : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  fn declared_in_sqlalchemy : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  # The last step, and the only one that knows the engine. It picks the
  # parameter style. The statement is rendered; the values are not.
  fn render : (declares: Declaration, engine: Engine) -> Statement | Failure

  fn render_operation : (operation: Operation, engine: Engine) -> Statement | Failure

  # Shapes rows into the one key the word asked for. `all` gives instances,
  # `values` gives mappings, `count` gives a number, and a partial instance is
  # never handed back.
  fn answered : (declares: Declaration, rows: list<any>) -> Answer

  fn diff : (current: Schema, target: Declared, decisions: dict<str, str>) -> Difference

  fn ordered : (operations: list<Operation>) -> list<int>

  fn ambiguities : (current: Schema, target: Declared) -> list<Ambiguity>

  fn validate : (declared: Declared) -> list<Failure> invokes habits_in

  # "The difference is asked of the exception's type", not of its message. A
  # conflict is retried and a refusal is not.
  fn is_contention : (failure: Failure) -> bool

  # "Retries back off, with jitter."
  fn delay_before : (retry: Retry, attempt: int) -> float

  fn new_room : () -> Room

  # "You deposit and you're free." Hands back a ticket immediately, runs
  # nothing, and the caller asks for the answer later.
  fn deposit : (room: Room, declares: Declaration) -> str

  fn collect : (room: Room, ticket: str) -> Receipt

  # --- column 2: the orchestrators ---------------------------------------
  #
  # Each owns one sequence, none composes with another, and none reaches back
  # into column 1. Every one takes a Database, and there is exactly one place a
  # Database comes from, which is why every chain below starts where it does.

  orchestrator fn ask : (db: Database, declares: Declaration) -> Answer invokes render, execute, answered

  orchestrator fn write : (db: Database, declares: Declaration) -> Answer invokes render, writing, execute, answered

  # A list handed to one call lands together. Two separate calls do not, unless
  # a caller declares a group, and then the group reports as one answer.
  orchestrator fn write_group : (db: Database, group: Group) -> Answer invokes render, writing, execute, answered

  orchestrator fn migrate : (db: Database, declared: Declared) -> Answer invokes introspect, validate, ambiguities, diff, ordered, render, render_operation, writing, execute

  # A crew is N drainers over one room, each holding one connection for its
  # whole life. A caller never writes a retry loop.
  orchestrator fn drain : (db: Database, room: Room, retry: Retry) -> Answer invokes render, writing, execute, is_contention, delay_before

  # The one place blocking is correct. It pushes until the primary has
  # everything, retrying rather than giving up, because the usual deployment has
  # disk that does not survive the process.
  orchestrator fn shut_down : (db: Database, retry: Retry) -> Answer invokes replicate, delay_before, close

  # --- the chains ---------------------------------------------------------
  #
  # A chain is the world's own path: in at a boundary, through the orchestrator
  # that owns the sequence, out at a boundary. The pure core is not on it and is
  # reached by the orchestrator's `invokes`.
  #
  # THE ANSWER LEAVES BY RETURN, NOT THROUGH A DOOR. A caller is not on this
  # board, so no chain ends at one. An application declares `route "GET /people"
  # -> ask` in its own .hd, and that is where the answer goes.

  chain migrating = load_models -> migrate -> execute

  chain asking = open_database -> ask -> execute

  chain writing_a_row = open_database -> write -> execute

  chain writing_a_group = open_database -> write_group -> execute

  chain draining = open_database -> drain -> execute

  chain shutting_down = open_database -> shut_down -> close

  chain replicating = open_database -> shut_down -> replicate
