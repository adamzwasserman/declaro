# declaro-persistum, declared from the specification rather than from the code.
#
# SOURCES, IN ORDER, AND NOTHING ELSE. `HOW-IT-SHOULD-WORK.md` says what a
# caller can ask for. `docs/architecture.md` says what shape it has to take.
# `tests/bdd/features/` says it again as scenarios. No source file was opened to
# write this, deliberately: the declaration is what the code follows, so reading
# the code to write it would make it a description of what exists and the two
# would then be one thing wearing two names.
#
# SO PARTS OF THIS ARE NOT BUILT. That is the point rather than a defect. Three
# of the four grammars, the declaration the grammars produce, and the checking
# step are specified and absent. A declaration that only says what exists cannot
# be a target.

module declaro-persistum

  layer data

  # --- the vocabularies -------------------------------------------------
  #
  # Each of these is a closed set the documents name. Written as a vocabulary
  # rather than `str`, because `str` admits every string and then a test has to
  # go looking for the ones that mean something.

  set engines = { "postgresql", "sqlite", "turso" }
  vocabulary Engine = { engines }

  set directions = { "ascending", "descending" }
  vocabulary Direction = { directions }

  # HOW-IT-SHOULD-WORK, "Narrowing": fifteen operators, named as keys because a
  # condition is data. Each takes an `ignore_case` companion for text.
  set operators = {
    "eq", "ne", "lt", "lte", "gt", "gte", "in", "not_in", "between",
    "like", "contains", "startswith", "endswith", "is_null", "is_not_null"
  }
  vocabulary Operator = { operators }

  # HOW-IT-SHOULD-WORK, "What you can ask for": the whole vocabulary, and every
  # one of them means one thing. A word not in this set is not a question this
  # library answers.
  set words = {
    "all", "one", "first", "page", "ordered_by", "values", "distinct", "exists",
    "count", "sum", "average", "smallest", "largest", "count_distinct",
    "grouped_by", "having",
    "add", "change", "change_all", "remove", "remove_all", "replace",
    "of"
  }
  vocabulary Word = { words }

  # "You say that in plain terms", for a materialized view.
  set freshness = { "always", "hourly", "daily", "on_demand" }
  vocabulary Freshness = { freshness }

  # --- what a caller declares -------------------------------------------

  type Column = {
    means: str
    optional: bool
    references: str
  }

  type Model = {
    table: str
    columns: dict<str, Column>
  }

  type Schema = dict<str, Model>

  # WHAT A SCHEMA FILE DECLARES, all of it. `View` and `Index` were declared
  # types no function named, which is the map saying that a whole section of
  # the specification had no path: "a view is a query with a name, you declare
  # it against your models the way you declare a table".
  type Declared = {
    models: Schema
    views: dict<str, View>
    indexes: dict<str, Index>
  }

  # A condition is data, and it nests: `{"or": [{...}, {...}]}` is in the
  # specification, so a flat list of triples cannot hold one.
  type Condition = {
    column: str
    operator: Operator
    value: any
    ignore_case: bool
    any_of: list<Condition>
    none_of: list<Condition>
  }

  type Ordering = {
    column: str
    direction: Direction
  }

  type Paging = {
    size: int
    number: int
  }

  # WHAT FOUR GRAMMARS PRODUCE. `HOW-IT-SHOULD-WORK` line 87: each grammar is a
  # thin skin over the same declaration. This is that declaration, and it is
  # what a view holds as well, because "the library writes the SELECT" only
  # means something if a view holds a value the library can render.
  #
  # NO DATABASE FIELD. A view is declared in a schema file with no database in
  # sight, and it holds one of these.
  type Declaration = {
    word: Word
    model: Model
    columns: list<str>
    narrowing: list<Condition>
    order: list<Ordering>
    paging: Paging
    measures: dict<str, Word>
    kept: list<Condition>
    values: dict<str, any>
    related: Model
  }

  type View = {
    name: str
    declares: Declaration
    materialized: bool
    fresh: Freshness
  }

  type Index = {
    name: str
    columns: list<str>
    unique: bool
  }

  # --- what the library gives back ---------------------------------------

  # "A function that cannot do its job returns that fact to you. It does not
  # write it to a log nobody reads."
  type Failure = {
    what: str
    because: str
  }

  # One shape for every word. A word fills one key and leaves the rest as the
  # named absence, so a missing row and a failure are values you must look at.
  type Answer = {
    rows: list<any>
    row: any
    number: int
    truth: bool
    mappings: list<dict<str, any>>
    failure: Failure
  }

  # What rendering produces: the statement, and the values it did NOT write into
  # the statement, kept apart so the driver binds them.
  type Statement = {
    sql: str
    parameters: dict<str, any>
  }

  # --- the schema half ---------------------------------------------------

  type Operation = {
    kind: str
    table: str
    detail: dict<str, any>
  }

  # "Ambiguity comes back instead of getting guessed."
  type Ambiguity = {
    table: str
    gone: str
    arrived: str
  }

  type Difference = {
    operations: list<Operation>
    order: list<int>
    ambiguities: list<Ambiguity>
  }

  # Data carrying its own injected callables and its engine, decided once.
  type Database = {
    target: str
    engine: Engine
    primary: str
    connect: any
    close_connection: any
    shutdown: str
  }

  # --- the write queue ---------------------------------------------------

  type Room = {
    arrivals: list<any>
    waiting: dict<str, any>
  }

  type Receipt = {
    ticket: str
    ok: bool
    failure: Failure
  }

  type Retry = {
    attempts: int
    base_delay_s: float
    max_delay_s: float
  }

  # --- column 1: input I/O, everything that reads the world ---------------

  boundary_in fn load_models : (module_path: str) -> Declared side_effect reads "python_module"

  boundary_in fn introspect : (db: Database) -> Schema side_effect reads "database"

  # One door. The target says which engine is behind it, so a caller never names
  # one. `tests/bdd/features/opening/open_database.feature`.
  boundary_in fn open_database : (target: str, shutdown: str) -> Database side_effect reads "network"

  # A read waits for nothing: the local file is a full copy, so a read never
  # touches the primary.
  boundary_in fn reading : (db: Database) -> any side_effect reads "database"

  # --- column 4: output I/O, everything that writes it --------------------

  # Scopes a transaction, commits on a clean exit, rolls back on an exception.
  # The only thing here that gives you rollback.
  boundary_out fn writing : (db: Database) -> any side_effect writes "database"

  boundary_out fn replicate : (db: Database) -> bool side_effect writes "network"

  boundary_out fn close : (db: Database) -> Database side_effect writes "network"

  # --- column 3: the pure core -------------------------------------------
  #
  # "Diffing, ordering, ambiguity detection, validation, SQL rendering: all
  # functions over data, and none of them opens anything."

  # THE CHECK THAT MAKES THE SURFACE DECLARATIVE, and the one the drawing that
  # preceded this file left out entirely. "Ask for a column no model declares,
  # and the library stops you in your own process. It names your model and lists
  # the columns it does declare."
  fn checked : (model: Model, columns: list<str>) -> list<str> | Failure

  # The pure decision `open_database` rests on. A string in, one of three words
  # out, and it opens nothing.
  fn engine_of : (target: str) -> Engine | Failure

  # The four grammars. Four thin skins, one value. A fifth is a fifth card here
  # and changes nothing to its right.
  fn declared_in_pseudo_sql : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  fn declared_in_django : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  fn declared_in_prisma : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  fn declared_in_sqlalchemy : (model: Model, asked: dict<str, any>) -> Declaration | Failure invokes checked

  # The last step, and the only one that knows the engine. The statement is
  # rendered; the values are not, and come back beside it.
  fn render : (declares: Declaration, engine: Engine) -> Statement

  fn render_operation : (operation: Operation, engine: Engine) -> Statement

  # Shapes rows into the one key the word asked for.
  fn answered : (declares: Declaration, rows: list<any>) -> Answer

  fn diff : (current: Schema, target: Schema, decisions: dict<str, str>) -> Difference

  fn ordered : (operations: list<Operation>) -> list<int>

  fn ambiguities : (current: Schema, target: Schema) -> list<Ambiguity>

  fn validate : (schema: Schema) -> list<Failure>

  fn new_room : () -> Room

  fn deposit : (room: Room, declares: Declaration) -> str

  fn is_contention : (failure: Failure) -> bool

  fn delay_before : (retry: Retry, attempt: int) -> float

  fn collect : (room: Room, ticket: str) -> Receipt

  # --- column 2: the orchestrators ---------------------------------------
  #
  # Each owns one sequence and none of them composes with another. None calls a
  # boundary to its left: what an input boundary produced arrives as an
  # argument, because an arrow into column 1 is the one direction that cannot
  # happen.

  orchestrator fn ask : (db: Database, declares: Declaration) -> Answer invokes render, answered

  orchestrator fn write : (db: Database, declares: Declaration) -> Answer invokes render, writing, answered

  orchestrator fn migrate : (db: Database, declared: Declared, live: Schema) -> Answer invokes ambiguities, validate, diff, ordered, render, render_operation, writing

  orchestrator fn drain : (db: Database, room: Room, retry: Retry) -> Answer invokes render, writing, is_contention, delay_before

  # --- the chains: how the world reaches the work ------------------------
  #
  # TWO OF THESE ARE TWO CARDS AND THAT IS HONEST. A read has no output
  # boundary: the Answer goes back to a caller who is not on this board. A write
  # has no input boundary: the caller's row arrives as an argument.

  chain migrating = load_models -> migrate -> writing

  chain asking = reading -> ask

  chain writing_a_row = write -> writing

  chain draining = drain -> writing

  chain replicating = replicate
