# declaro-ximinez, declared from the specification rather than from the code.
#
# SOURCES, IN ORDER. `docs/architecture/ximinez-architecture.md`, then
# `tests/bdd/features/`. No source file is opened to write this.
#
# WHAT IT IS. A preprocessing static type enforcer: every local variable must
# be explicitly typed, and a file that says otherwise is refused before it
# reaches a commit. It runs in a pre-commit hook or on a build machine, so its
# world is files on a disk and an operator reading a terminal.

module declaro-ximinez

  layer tooling

  # A LOCAL VARIABLE AS THE CHECKER SEES IT. Section 6.2: a per-function symbol
  # table tracking the name, the declared type, where it is, whether it was
  # given a value and whether anything reads it.
  type Local = { name: str
                 declared_type: str | NOTHING
                 line: int
                 initialized: bool
                 used: bool } note "a name, a declared type, and whether anything reads it"

  type FunctionScope = { name: str
                         line: int
                         style: Style | NOTHING
                         locals: list<Local> } note "one function, its style and its locals"

  # TWO STYLES, AND A FUNCTION PICKS ONE. Section 4.1 makes them mutually
  # exclusive per function: annotations on first assignment, or one `types:`
  # block at the top. `style_mixing.feature` is the file that says a function
  # using both is refused.
  set styles = { "inline" : "a type beside each first assignment", "block" : "one types: block at the top of the function" } note "a type beside each assignment, or one block at the top"
  vocabulary Style = { styles } note "a function picks one and keeps to it"

  type Violation = { rule: Rule
                     file: str
                     line: int
                     what_went_wrong: str
                     what_to_do_instead: str } note "what is wrong, where, and what to write instead"

  # WHAT THE CHECKER CAN REFUSE. Drawn from the feature files, one rule each:
  # an undeclared local, a type that does not match what was assigned, the two
  # styles in one function, and a field no model declares.
  set rules = { "undeclared_local" : "a local with no declared type", "type_mismatch" : "what was assigned does not fit what was declared", "mixed_styles" : "one function used both styles", "unknown_field" : "a field the model does not declare" } note "the four things a file can be refused for"
  vocabulary Rule = { rules } note "which rule this violation broke"

  # A MODEL, AS LOADED FROM THE CALLER'S OWN FILES. Section 6.3: field names
  # and types, relationships and their targets.
  type Model = { name: str
                 fields: dict<str, str>
                 relationships: dict<str, str> } note "the caller's own schema, as this tool reads it"

  # THREE ENDINGS, AND A BUILD MACHINE HAS TO TELL THEM APART. Section 6.8: no
  # violations is 0, violations found is 1, and a file that would not parse or
  # a configuration that makes no sense is 2.
  set endings = { "clean" : "0, nothing to report", "violations" : "1, the file is refused", "unusable" : "2, the source would not parse or the configuration is wrong" } note "clean, refused, or unusable"
  vocabulary Ending = { endings } note "which of the three this run was"

  # HOW MUCH THE OPERATOR WANTS TO READ. Section 6.7, one word per flag.
  set reports = { "standard", "quiet", "machine", "full" } note "four ways to read the same violations"
  vocabulary ReportStyle = { reports } note "how much the operator wants to read"

  type Fault = { what_went_wrong: str
                 what_to_do_instead: str } note "two fields, because naming the problem is only half of one"

  # `check_run`'S OWN RECORD.
  type Checking = { paths: list<str>
                    report_style: ReportStyle
                    models_path: str | NOTHING
                    scopes: list<FunctionScope>
                    models: list<Model>
                    violations: list<Violation>
                    ending: Ending } note "the files, what they declare, and what was found"

  # --- column 1: how the world gets in ------------------------------------

  # An operator, or the hook standing in for one, asks for these files to be
  # checked.
  boundary_in fn command_run : (argv: list<str>) -> int | Fault side_effect reads "argv" invokes check_run note "a hook or an operator asks for these files to be checked"

  # THE FILES ARE ASKED FOR, THEY DO NOT ARRIVE. Both of these are the program
  # reading what it was pointed at, so they are readers rather than doors.
  reader fn files_read_source : (path: str) -> str | Fault side_effect reads "files" note "the program reads what it was pointed at"
  reader fn files_read_models : (path: str) -> list<str> | Fault side_effect reads "files" note "the caller's Pydantic models, so a field can be checked"

  # --- column 2 ------------------------------------------------------------

  # Reads each file, collects what every function declares, checks it against
  # what the code does and against the models, and turns what it found into an
  # exit code.
  orchestrator fn check_run : (checking: Checking) -> Checking | Fault invokes files_read_source, parse_source, scopes_of, style_of, undeclared_locals, type_mismatches, files_read_models, models_from_source, unknown_fields, nearest_field, ending_for, format_report, terminal_print, log_write note "read, collect, check, and turn what was found into an exit code"

  # --- column 3: the pure core ---------------------------------------------

  # Section 6.1: the source becomes a tree without losing its formatting, and
  # `types:` is read as an indented block rather than as a syntax error.
  fn parse_source : (source: str) -> Tree | Fault note "types: is read as a block rather than as a syntax error"

  type Tree = { path: str
                nodes: list<str> } note "the source, parsed without losing its formatting"

  fn scopes_of : (tree: Tree) -> list<FunctionScope> note "one symbol table per function, because a style is per function"

  # A function declares one style or the other, and a function using both is a
  # violation rather than a preference.
  fn style_of : (scope: FunctionScope) -> Style | Violation note "a function using both styles is a violation, not a preference"

  # THE RULE THE TOOL EXISTS FOR. Every local is typed, so a local with no type
  # is named with its line and what to write instead.
  fn undeclared_locals : (scope: FunctionScope) -> list<Violation> note "the rule this tool exists for"

  # What was assigned has to fit what was declared.
  fn type_mismatches : (scope: FunctionScope) -> list<Violation> note "what was assigned has to fit what was declared"

  # Section 6.3: the caller's own Pydantic models, read into field names,
  # types, and the relationships between them.
  fn models_from_source : (sources: list<str>) -> list<Model> | Fault note "field names, types, and the relationships between them"

  # Section 6.4: a field access checked against the model that declares it.
  fn unknown_fields : (scope: FunctionScope, models: list<Model>) -> list<Violation> note "a field access checked against the model that declares it"

  # A MISSPELT FIELD IS TOLD WHICH FIELD IT MEANT. Section 6.4 suggests a
  # correction by edit distance, which is what makes the violation say what to
  # do rather than only what is wrong.
  fn nearest_field : (asked: str, model: Model) -> str | NOTHING note "a misspelt field is told which field it meant"

  fn ending_for : (violations: list<Violation>) -> Ending note "0, 1 or 2, so a build machine can act on it"

  # One violation list, four ways to read it.
  fn format_report : (violations: list<Violation>, style: ReportStyle) -> str note "one violation list, four ways to read it"

  # --- column 4: what it writes -------------------------------------------

  boundary_out fn terminal_print : (line: str) -> NOTHING side_effect writes "terminal" note "what the developer reads"

  boundary_out fn log_write : (event: dict<str, str>) -> NOTHING side_effect writes "log" note "read afterwards, never instead of returning a fault"
